  "components": {
    "schemas": {
      "AnswerResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "author_id": {
            "type": "string",
            "format": "uuid",
            "title": "Author Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "votes": {
            "type": "integer",
            "title": "Votes"
          },
          "is_accepted": {
            "type": "boolean",
            "title": "Is Accepted"
          },
          "comments": {
            "items": {
              "$ref": "#/components/schemas/CommentResponse"
            },
            "type": "array",
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "body",
          "author_id",
          "created_at",
          "votes",
          "is_accepted"
        ],
        "title": "AnswerResponse",
        "description": "回答白名单（US-A01/A05）：votes 为净票数（v3 裁定 #1，可为负）。"
      },
      "AskQuestionRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "AskQuestionRequest",
        "description": "POST /api/v1/questions 请求体。\n\nstr_strip_whitespace 在长度约束之前生效：纯空白标题/正文 strip 后为空 → 422。"
      },
      "CommentRequest": {
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "body"
        ],
        "title": "CommentRequest",
        "description": "评论请求体（US-C01）：正文复用 Body 值对象约束（v3 自裁：1~5000 字）。"
      },
      "CommentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "author_id": {
            "type": "string",
            "format": "uuid",
            "title": "Author Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "body",
          "author_id",
          "created_at"
        ],
        "title": "CommentResponse",
        "description": "评论白名单（按时间正序返回，1.3 功能域 9）。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Identifier"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identifier",
          "password"
        ],
        "title": "LoginRequest",
        "description": "POST /api/v1/auth/login 请求体：identifier 为学号或工号。"
      },
      "PostAnswerRequest": {
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "body"
        ],
        "title": "PostAnswerRequest",
        "description": "POST /api/v1/questions/{qid}/answers 请求体（US-A01）。\n\n正文与问题共用 1~5000 字约束；作者只取令牌，绝不取自请求体。"
      },
      "QuestionDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "author_id": {
            "type": "string",
            "format": "uuid",
            "title": "Author Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "accepted_answer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted Answer Id"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/AnswerResponse"
            },
            "type": "array",
            "title": "Answers"
          },
          "comments": {
            "items": {
              "$ref": "#/components/schemas/CommentResponse"
            },
            "type": "array",
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "author_id",
          "created_at",
          "accepted_answer_id"
        ],
        "title": "QuestionDetailResponse",
        "description": "详情白名单。\n\nanswers 按 D2 定稿排序（已采纳恒最前 > 净票数降序 > 时间正序）；\naccepted_answer_id 顶层返回便于前端直接定位（v3 裁定 #3）；\ncomments 为题评（US-C01，按时间正序）；tags 迭代 1 恒为空列表（分支 3 就位）。"
      },
      "QuestionListItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author_id": {
            "type": "string",
            "format": "uuid",
            "title": "Author Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author_id",
