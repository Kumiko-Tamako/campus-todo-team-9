      "get": {
        "tags": [
          "questions"
        ],
        "summary": "问题列表（访客可用，默认按发布时间新→旧，可按净票数排序）",
        "operationId": "list_questions_api_v1_questions_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "页码，从 1 起",
              "default": 1,
              "title": "Page"
            },
            "description": "页码，从 1 起"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "每页条数，上限 100（S-05）",
              "default": 20,
              "title": "Page Size"
            },
            "description": "每页条数，上限 100（S-05）"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/QuestionSort",
              "description": "排序：latest=最新（默认）；votes=净票数高→低（US-Q02 迭代 2）",
              "default": "latest"
            },
            "description": "排序：latest=最新（默认）；votes=净票数高→低（US-Q02 迭代 2）"
          }
        ],
